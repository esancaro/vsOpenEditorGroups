{
  "name": "open-editor-groups",
  "displayName": "Open Editor Groups",
  "description": "Group and organize open editors in a tree view with drag and drop, nested groups, sort, and persistent workspace storage.",
  "version": "0.1.8",
  "publisher": "esancaro",
  "author": {
    "name": "Esteban Castro",
    "email": "esancaro@gmail.com"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#15202B",
    "theme": "dark"
  },
  "homepage": "https://github.com/esancaro/vsOpenEditorGroups#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/esancaro/vsOpenEditorGroups.git"
  },
  "bugs": {
    "url": "https://github.com/esancaro/vsOpenEditorGroups/issues"
  },
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "open editors",
    "editor groups",
    "tabs",
    "grouping",
    "organize",
    "explorer",
    "tree",
    "files"
  ],
  "activationEvents": [
    "onView:manualEditorGroups"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "manualEditorGroups",
          "name": "Open Editor Groups",
          "icon": "$(list-tree)",
          "contextualTitle": "Open Editor Groups"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "manualEditorGroups",
        "contents": "No open editors to group yet.\n\nOpen some files, then create a group with the + button or by right-clicking in this view.\nDrag files here from the Explorer or from the ungrouped list.",
        "when": "workbenchState == folder"
      },
      {
        "view": "manualEditorGroups",
        "contents": "No grouped or open files to show yet. Workspace folders stay hidden until they have a group or an open editor. Create Group asks which folder should store the group.\n[Create Group](command:manualEditorGroups.createGroup)",
        "when": "workbenchState == workspace"
      }
    ],
    "commands": [
      {
        "command": "manualEditorGroups.createGroup",
        "title": "Create Group",
        "category": "OEG",
        "icon": "$(add)"
      },
      {
        "command": "manualEditorGroups.createSubgroup",
        "title": "Create Subgroup",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.renameGroup",
        "title": "Rename Group",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.deleteGroup",
        "title": "Delete Group",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.hideGroup",
        "title": "Hide Group",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.showHiddenGroups",
        "title": "Show Hidden Groups...",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.ungroupFile",
        "title": "Remove from Group",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.addToGroup",
        "title": "Add to Group",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.moveToGroup",
        "title": "Move to Group",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.openFilesInGroup",
        "title": "Open Files...",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.openAllFilesInGroup",
        "title": "Open All Files",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.addToNewGroup",
        "title": "Add to New Group",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.groupByPattern",
        "title": "Group by Pattern",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.groupByPatternSet",
        "title": "✓ Group by Pattern",
        "category": "OEG",
        "icon": "$(check)"
      },
      {
        "command": "manualEditorGroups.manageGroupPatterns",
        "title": "Manage Group Patterns",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.closeEditor",
        "title": "Close",
        "category": "OEG",
        "icon": "$(close)"
      },
      {
        "command": "manualEditorGroups.backupOpen",
        "title": "Backup Open Files",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.backupAll",
        "title": "Backup All Files",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.restoreBackup",
        "title": "Restore",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.flagNone",
        "title": "Flag",
        "category": "OEG",
        "icon": {
          "light": "media/flag.svg",
          "dark": "media/flag.svg"
        }
      },
      {
        "command": "manualEditorGroups.flagRedOn",
        "title": "Red flag",
        "category": "OEG",
        "icon": {
          "light": "media/flag-red-on.svg",
          "dark": "media/flag-red-on.svg"
        }
      },
      {
        "command": "manualEditorGroups.flagYellowOn",
        "title": "Yellow flag",
        "category": "OEG",
        "icon": {
          "light": "media/flag-yellow-on.svg",
          "dark": "media/flag-yellow-on.svg"
        }
      },
      {
        "command": "manualEditorGroups.flagGreenOn",
        "title": "Green flag",
        "category": "OEG",
        "icon": {
          "light": "media/flag-green-on.svg",
          "dark": "media/flag-green-on.svg"
        }
      },
      {
        "command": "manualEditorGroups.closeEditorsInGroup",
        "title": "Close All in Group",
        "category": "OEG",
        "icon": "$(close-all)"
      },
      {
        "command": "manualEditorGroups.copyPath",
        "title": "Copy Path",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.copyFilename",
        "title": "Copy Filename",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.refresh",
        "title": "Refresh",
        "category": "OEG",
        "icon": "$(refresh)"
      },
      {
        "command": "manualEditorGroups.sortIconAscending",
        "title": "Sorted A-Z (click for Z-A)",
        "icon": "$(arrow-up)"
      },
      {
        "command": "manualEditorGroups.sortIconDescending",
        "title": "Sorted Z-A (click to turn sorting off)",
        "icon": "$(arrow-down)"
      },
      {
        "command": "manualEditorGroups.sortIconOff",
        "title": "Sorting off — drag to reorder (click for A-Z)",
        "icon": "$(gripper)"
      },
      {
        "command": "manualEditorGroups.sortByName",
        "title": "Sort A-Z",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.sortByNameDesc",
        "title": "Sort Z-A",
        "category": "OEG"
      },
      {
        "command": "manualEditorGroups.sortManual",
        "title": "Turn Off Sorting (Drag to Reorder)",
        "category": "OEG"
      }
    ],
    "submenus": [
      {
        "id": "manualEditorGroups.sortMenu",
        "label": "Sort"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "manualEditorGroups.createGroup",
          "when": "view == manualEditorGroups",
          "group": "navigation"
        },
        {
          "command": "manualEditorGroups.refresh",
          "when": "view == manualEditorGroups",
          "group": "navigation"
        },
        {
          "command": "manualEditorGroups.sortIconAscending",
          "when": "view == manualEditorGroups && manualEditorGroups.sortMode != nameDesc && manualEditorGroups.sortMode != manual",
          "group": "navigation"
        },
        {
          "command": "manualEditorGroups.sortIconDescending",
          "when": "view == manualEditorGroups && manualEditorGroups.sortMode == nameDesc",
          "group": "navigation"
        },
        {
          "command": "manualEditorGroups.sortIconOff",
          "when": "view == manualEditorGroups && manualEditorGroups.sortMode == manual",
          "group": "navigation"
        },
        {
          "submenu": "manualEditorGroups.sortMenu",
          "when": "view == manualEditorGroups",
          "group": "2_sort"
        },
        {
          "command": "manualEditorGroups.groupByPattern",
          "when": "view == manualEditorGroups",
          "group": "3_patterns@1"
        },
        {
          "command": "manualEditorGroups.manageGroupPatterns",
          "when": "view == manualEditorGroups",
          "group": "3_patterns@2"
        },
        {
          "command": "manualEditorGroups.showHiddenGroups",
          "when": "view == manualEditorGroups",
          "group": "4_hidden@1"
        }
      ],
      "manualEditorGroups.sortMenu": [
        {
          "command": "manualEditorGroups.sortByName",
          "group": "1_sort@1"
        },
        {
          "command": "manualEditorGroups.sortByNameDesc",
          "group": "1_sort@2"
        },
        {
          "command": "manualEditorGroups.sortManual",
          "group": "1_sort@3"
        }
      ],
      "commandPalette": [
        {
          "command": "manualEditorGroups.sortIconAscending",
          "when": "false"
        },
        {
          "command": "manualEditorGroups.sortIconDescending",
          "when": "false"
        },
        {
          "command": "manualEditorGroups.sortIconOff",
          "when": "false"
        },
        {
          "command": "manualEditorGroups.groupByPatternSet",
          "when": "false"
        },
        {
          "command": "manualEditorGroups.flagNone",
          "when": "false"
        },
        {
          "command": "manualEditorGroups.flagRedOn",
          "when": "false"
        },
        {
          "command": "manualEditorGroups.flagYellowOn",
          "when": "false"
        },
        {
          "command": "manualEditorGroups.flagGreenOn",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "manualEditorGroups.createGroup",
          "when": "view == manualEditorGroups && viewItem == workspace",
          "group": "1_group@0"
        },
        {
          "command": "manualEditorGroups.createSubgroup",
          "when": "view == manualEditorGroups && viewItem =~ /group/",
          "group": "1_group@1"
        },
        {
          "command": "manualEditorGroups.renameGroup",
          "when": "view == manualEditorGroups && viewItem =~ /group/",
          "group": "1_group@2"
        },
        {
          "command": "manualEditorGroups.deleteGroup",
          "when": "view == manualEditorGroups && viewItem =~ /group/",
          "group": "1_group@3"
        },
        {
          "command": "manualEditorGroups.hideGroup",
          "when": "view == manualEditorGroups && viewItem =~ /group/",
          "group": "1_group@5"
        },
        {
          "command": "manualEditorGroups.groupByPattern",
          "when": "view == manualEditorGroups && (viewItem == group || viewItem == group-flag-red || viewItem == group-flag-yellow || viewItem == group-flag-green)",
          "group": "1_group@4"
        },
        {
          "command": "manualEditorGroups.groupByPatternSet",
          "when": "view == manualEditorGroups && (viewItem == group-pattern || viewItem == group-pattern-flag-red || viewItem == group-pattern-flag-yellow || viewItem == group-pattern-flag-green)",
          "group": "1_group@4",
          "toggled": "true"
        },
        {
          "command": "manualEditorGroups.openFilesInGroup",
          "when": "view == manualEditorGroups && viewItem =~ /group/",
          "group": "0_open@1"
        },
        {
          "command": "manualEditorGroups.openAllFilesInGroup",
          "when": "view == manualEditorGroups && viewItem =~ /group/",
          "group": "0_open@2"
        },
        {
          "command": "manualEditorGroups.addToGroup",
          "when": "view == manualEditorGroups && (viewItem =~ /file/ || viewItem =~ /group/)",
          "group": "1_modification@1"
        },
        {
          "command": "manualEditorGroups.moveToGroup",
          "when": "view == manualEditorGroups && (viewItem =~ /file/ || viewItem =~ /group/)",
          "group": "1_modification@2"
        },
        {
          "command": "manualEditorGroups.ungroupFile",
          "when": "view == manualEditorGroups && viewItem == file",
          "group": "1_modification@3"
        },
        {
          "command": "manualEditorGroups.addToNewGroup",
          "when": "view == manualEditorGroups && (viewItem =~ /file/ || viewItem =~ /group/)",
          "group": "1_modification@4"
        },
        {
          "command": "manualEditorGroups.closeEditor",
          "when": "view == manualEditorGroups && viewItem =~ /file/",
          "group": "inline@0"
        },
        {
          "command": "manualEditorGroups.flagNone",
          "when": "view == manualEditorGroups && (viewItem == group || viewItem == group-pattern)",
          "group": "inline@1"
        },
        {
          "command": "manualEditorGroups.flagRedOn",
          "when": "view == manualEditorGroups && (viewItem == group-flag-red || viewItem == group-pattern-flag-red)",
          "group": "inline@1"
        },
        {
          "command": "manualEditorGroups.flagYellowOn",
          "when": "view == manualEditorGroups && (viewItem == group-flag-yellow || viewItem == group-pattern-flag-yellow)",
          "group": "inline@1"
        },
        {
          "command": "manualEditorGroups.flagGreenOn",
          "when": "view == manualEditorGroups && (viewItem == group-flag-green || viewItem == group-pattern-flag-green)",
          "group": "inline@1"
        },
        {
          "command": "manualEditorGroups.closeEditorsInGroup",
          "when": "view == manualEditorGroups && (viewItem == group || viewItem == group-pattern || viewItem == group-flag-red || viewItem == group-flag-yellow || viewItem == group-flag-green || viewItem == group-pattern-flag-red || viewItem == group-pattern-flag-yellow || viewItem == group-pattern-flag-green)",
          "group": "inline@4"
        },
        {
          "command": "manualEditorGroups.backupOpen",
          "when": "view == manualEditorGroups && viewItem =~ /group/",
          "group": "2_backup@1"
        },
        {
          "command": "manualEditorGroups.backupAll",
          "when": "view == manualEditorGroups && viewItem =~ /group/",
          "group": "2_backup@2"
        },
        {
          "command": "manualEditorGroups.restoreBackup",
          "when": "view == manualEditorGroups && viewItem =~ /group/",
          "group": "2_backup@3"
        },
        {
          "command": "manualEditorGroups.closeEditor",
          "when": "view == manualEditorGroups && viewItem =~ /file/",
          "group": "3_close@1"
        },
        {
          "command": "manualEditorGroups.closeEditorsInGroup",
          "when": "view == manualEditorGroups && viewItem =~ /group/",
          "group": "3_close@1"
        },
        {
          "command": "manualEditorGroups.copyPath",
          "when": "view == manualEditorGroups && viewItem =~ /file/",
          "group": "4_copy@1"
        },
        {
          "command": "manualEditorGroups.copyRelativePath",
          "when": "view == manualEditorGroups && viewItem =~ /file/",
          "group": "4_copy@2"
        },
        {
          "command": "manualEditorGroups.copyFilename",
          "when": "view == manualEditorGroups && viewItem =~ /file/",
          "group": "4_copy@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "manualEditorGroups.addToGroup",
          "group": "1_openEditorGroups@1"
        }
      ],
      "tab/context": [
        {
          "command": "manualEditorGroups.addToGroup",
          "group": "1_openEditorGroups@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.4.0"
  }
}
